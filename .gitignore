# ---------------------------------------------------------------------------
# RESTRICTED DATA — DO NOT REMOVE THESE RULES
# MIMIC-III / PhysioNet credentialed data and anything derived from it must
# never enter version control. PhysioNet DUA clause 3 (no sharing access) and
# clause 4 (reasonable and prudent electronic security).
# These rules are the control that keeps credentialed data out of version control.
# ---------------------------------------------------------------------------
# No trailing slash: local_only is a SYMLINK to storage outside this tree, and a
# trailing-slash pattern matches directories only -- it would miss the symlink
# and leave 216MB of MIMIC-derived data one `git add -A` from being committed.
local_only
**/local_only
local_only/
**/local_only/
*.csv
*.csv.gz
NOTEEVENTS*
PATIENTS*
ADMISSIONS*
PRESCRIPTIONS*
DIAGNOSES*
*note*.jsonl
*bundle*.jsonl
mimic*
MIMIC*

# Model artifacts and corpora.
# NOTE: these patterns are ANCHORED with a leading slash. An unanchored "data/"
# matches src/data/ anywhere in the tree and would silently drop this project's
# own source package from every commit.
/checkpoints/
/data/
*.bin
*.npy
*.pt
*.safetensors
*.xml.gz

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# OS
.DS_Store

# LaTeX build artifacts
accord/thesis/*.aux
accord/thesis/*.bbl
accord/thesis/*.blg
accord/thesis/*.log
accord/thesis/*.out
accord/thesis/*.toc
accord/thesis/*.lot
accord/thesis/*.lof

# Build/run logs anywhere, which can carry absolute local paths.
*.log

# results/accord/fairness/ and results/accord/survey/ hold hand-placed,
# content-checked aggregate CSVs (chi-square tables, cohort composition,
# and the survey coding tables) that predate the blanket *.csv rule above
# and carry no identifiers or note text -- verified against the same
# note-text/identifier markers scripts/sync_results.sh checks for. Each file
# is named explicitly, rather than un-blocking the whole directory by
# wildcard, so a future MIMIC-named file (NOTEEVENTS*, PATIENTS*, etc.)
# dropped into either directory stays blocked by the rules above.
!/results/accord/fairness/section1_chisquare_gof.csv
!/results/accord/fairness/section1_cohort_composition.csv
!/results/accord/fairness/section2_ambiguity_by_group.csv
!/results/accord/fairness/section2_ambiguity_chisquare.csv
!/results/accord/fairness/section3_fp_and_weak_positive_rates_by_group.csv
!/results/accord/fairness/section3_weak_label_chisquare.csv
!/results/accord/fairness/section4_outcomes_by_group.csv
!/results/accord/fairness/section4_outcomes_chisquare.csv
!/results/accord/fairness/section5_kappa_power_reproduction.csv
!/results/accord/survey/coding_table.csv
!/results/accord/survey/screening_log.csv
!/results/accord/survey/second_coder_table.csv

# Private correspondence, never publish.
accord/thesis/COMPLIANCE_EMAIL_DRAFT.md

# Agent and tooling scratch, not part of the release.
.claude/

# Private correspondence drafts, never publish.
accord/thesis/*_QUERY.md

# Hosted-channel outputs are held locally only (see results/accord/withdrawn_hosted/README.md).
/results/accord/withdrawn_hosted/*.json

# Working and planning notes kept locally, not part of the released thesis repository.
/CLAUDE.md
/DESIGN.md
/accord/CONTRIBUTION.md
/accord/FORMAT.md
/accord/FRAMING.md
/accord/PHD_PLAN.md
/accord/THESIS_STATUS.md
/accord/WRITING_PLAN.md
