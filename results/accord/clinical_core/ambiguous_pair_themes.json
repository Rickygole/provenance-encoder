 "method": "One free-text justification per gold pair was coded against seven fixed regular expressions over generic clinical-reasoning vocabulary. Multi-label incidence counts every theme a justification touches; the primary category is the highest-priority theme it touches, under the priority order recorded here. The justification text is never written, printed or quoted.",
 "theme_definitions": {
  "insufficient_documentation": "The pharmacist states the two sentences do not carry enough to decide, and asks for information the pair does not contain.",
  "dose_or_frequency_uncertainty": "The apparent conflict is about how much or how often, not about whether the drug is on or off, and the pair does not fix the amount.",
  "care_setting_transition": "The two sides describe different phases of care, so a difference between them is what a transition looks like rather than an error.",
  "temporal_sequence": "The two statements plausibly refer to different moments, typically a hold followed by a restart, and the pair does not fix the order.",
  "monitoring_dependent": "Whether the pair is an error depends on a laboratory or monitoring value that is not in either sentence.",
  "plausible_clinical_alternative": "A benign clinical reading of the pair exists, so the pharmacist declined to call it an error without committing to it being correct either.",
  "class_versus_agent": "The conflict sits between a class-level instruction and a named agent, or between two agents of one class, so what counts as the same medication is itself in question.",
  "uncategorised": "The justification matched none of the seven themed patterns."
 },
 "theme_patterns": {
  "insufficient_documentation": "informations?|insufficient|not sure|unsure|unclear|not clear|cannot (?:tell|determine|say|conclude)|can'?t (?:tell|say)|needs? (?:more|to be|further|additional)|provide|missing|not (?:specif|mention|document|state)|no (?:detail|clear)|more (?:detail|context|information)|why",
  "dose_or_frequency_uncertainty": "dosages?|doses?|dosed|dosing|titrat|adjust|increas|decreas|reduc|taper|once|twice|three times|daily|frequency|divided|total daily|\\bmg\\b|units?",
  "care_setting_transition": "inpatient|outpatient|discharg|\\bhome\\b|transition",
  "temporal_sequence": "restart|resum|held|hold|temporar|later|\\btimes?\\b|timing|sequence|same day|day \\d|earlier",
  "monitoring_dependent": "\\binr\\b|\\bptt\\b|levels?|monitor|\\blab\\b|bleeding|platelet|creatinine|potassium level|rate control|heart rate",
  "plausible_clinical_alternative": "likely|probabl|\\bmay\\b|could|possib|however|reflect|appropriate|expected|indication|depends|standard|guideline",
  "class_versus_agent": "\\bclass\\b|together|\\bboth\\b|different (?:drug|medication|agent|beta)|substitut|blocker"
 },
